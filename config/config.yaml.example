# Non-secret defaults. Override secrets with DP1_FEED_* environment variables.

server:
  host: "0.0.0.0"
  port: 8787
  read_timeout: 30s
  # Must exceed fetch_timeout + notifications.timeout + response_write_reserve.
  # Increase it further when one mutation can resolve more than eight remote playlists.
  write_timeout: 60s
  # Held back from notified channel work so the HTTP response can still be written.
  response_write_reserve: 1s
  idle_timeout: 120s
  # Inbound request body cap; bodies are buffered for signature auth, so this bounds pre-auth memory.
  # Override with DP1_FEED_MAX_REQUEST_BYTES. Default 5 MiB.
  max_request_bytes: 5242880

database:
  url: "postgres://postgres:postgres@localhost:5432/dp1_feed?sslmode=disable"
  max_conns: 16
  min_conns: 2
  max_conn_lifetime: 1h

auth:
  # Mutating routes are authorized by request signatures, not an API key.
  # intent_max_clock_skew bounds how far a signed mutation intent's "created" may sit from server time.
  # It applies to BOTH the PUT replace-intent and the DELETE intent, so widening it widens the replay
  # window for edits as well as deletions; narrowing it can make slow or clock-skewed clients fail PUTs.
  # Override with DP1_FEED_INTENT_MAX_CLOCK_SKEW (Go duration, e.g. 5m).
  intent_max_clock_skew: "5m"

sentry:
  dsn: ""

logging:
  debug: true

extensions:
  enabled: true

# Browser CORS. Omit or use allow_origins: ["*"] for any origin (default). Override list with DP1_FEED_CORS_ALLOW_ORIGINS (comma-separated).
cors:
  allow_origins:
    - "*"

playlist:
  fetch_timeout: 30s
  fetch_max_body_bytes: 4194304
  # max_playlist_references caps how many playlist URIs one group or channel may reference.
  # Creation is open to any client and every reference this feed does not already store becomes an
  # outbound fetch, so this bounds fan-out per request; over the cap is a 400. Env:
  # DP1_FEED_MAX_PLAYLIST_REFERENCES.
  max_playlist_references: 1000
  # max_resolved_bytes caps the TOTAL size of resolved playlist documents held in memory for one
  # group/channel write. The reference count and fetch_max_body_bytes do not bound memory between them,
  # they multiply, so this is the setting that actually bounds it. Env: DP1_FEED_MAX_RESOLVED_BYTES.
  max_resolved_bytes: 67108864
  # Ed25519 seed: 32 bytes = 64 hex chars. Required — generate: openssl rand -hex 32 (or set DP1_FEED_SIGNING_KEY_HEX)
  signing_key_hex: ""
  # Set DP1_FEED_PUBLIC_BASE_URL to an externally reachable URL when clients are enabled.
  public_base_url: "http://localhost:8787"

# Optional channel lifecycle consumers. Keep private_key_hex in
# DP1_FEED_WEBHOOK_PRIVATE_KEY_HEX outside checked-in YAML.
notifications:
  timeout: 15s
  private_key_hex: ""
  clients: []
  # To enable a client, replace the empty list above with:
  # clients:
  #   - name: "art-catalog"
  #     url: "https://catalog.example/webhooks/v1/channels"
