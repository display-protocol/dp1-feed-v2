# Copy to .env and adjust (loaded by docker-compose or your shell).
# The server reads DP1_FEED_* variables from the environment.

# Database connection (use 'postgres' as hostname in Docker, 'localhost' for local dev)
DP1_FEED_DATABASE_URL=postgres://postgres:postgres@postgres:5432/dp1_feed?sslmode=disable

# Mutating routes are authorized by request signatures, not an API key.
# Freshness window for signed mutation intents — both the PUT replace-intent and the DELETE intent
# (Go duration; default 5m). Widening it widens the replay window for edits as well as deletions.
DP1_FEED_INTENT_MAX_CLOCK_SKEW=5m

# Max playlist URIs one group or channel may reference (default 1000). Bounds outbound fan-out, since
# every reference this feed does not already store becomes a fetch.
DP1_FEED_MAX_PLAYLIST_REFERENCES=1000

# Total bytes of resolved playlist documents one group/channel write may hold in memory (default 64 MiB).
# Reference count x per-fetch cap multiply, so this is the real memory bound.
DP1_FEED_MAX_RESOLVED_BYTES=67108864

# Ed25519 signing key (64 hex chars). Generate with: openssl rand -hex 32
DP1_FEED_SIGNING_KEY_HEX=your-signing-key-here

# Enable debug logging
DP1_FEED_LOG_DEBUG=true

# Stable service-log dimensions.
DP1_FEED_LOG_SERVICE=dp1-feed-v2
DP1_FEED_LOG_ENVIRONMENT=development

# Optional Cloudflare Pipeline Stream delivery. Set both to enable it. Create a producer-specific
# account token with Pipelines Send only; do not use an R2 catalog token.
# DP1_FEED_CLOUDFLARE_STREAM_URL=https://d116f309b6ce41b3ab535d6ba1b790fe.ingest.cloudflare.com
# DP1_FEED_CLOUDFLARE_API_KEY=

# Optional channel notification signing. Generate a 32-byte P-256 private scalar
# with `openssl rand -hex 32`; startup logs the derived public key for consumers.
# The public base URL must be reachable by every configured notification client.
# Generate with: openssl rand -hex 32
# DP1_FEED_PUBLIC_BASE_URL=https://feed.example
# DP1_FEED_WEBHOOK_PRIVATE_KEY_HEX=
# DP1_FEED_NOTIFICATION_CLIENTS=[{"name":"art-catalog","url":"https://catalog.example/webhooks/v1/channels"}]

# Inbound request body cap in bytes (default 5 MiB)
DP1_FEED_MAX_REQUEST_BYTES=5242880
